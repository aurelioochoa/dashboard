{
  "name": "homelab-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @homelab/shared build && pnpm --parallel --filter \"./packages/*\" dev",
    "build": "pnpm --filter @homelab/shared build && pnpm --filter @homelab/frontend build && pnpm --filter @homelab/backend build",
    "start": "pnpm --filter @homelab/backend start",
    "lint": "eslint packages --ext .ts",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "js-yaml": "^4.3.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
