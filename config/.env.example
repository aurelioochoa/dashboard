# Copy to `.env` and edit for your setup:
#
#   cp config/.env.example config/.env
#   $EDITOR config/.env
#   make up
#

# ─── Dashboard ───

# Host port the dashboard listens on.
DASHBOARD_PORT=8080

# Log verbosity: trace | debug | info | warn | error | silent
LOG_LEVEL=info

# Seconds between reachability probes of every service/port/link.
HEALTH_INTERVAL=30

# Resolver for the health prober. Probes run inside the container, which by
# default sees only Docker's embedded DNS and cannot resolve internal names.
# Point this at your LAN resolver if config.yaml contains internal
# hostnames like nas.home.arpa — otherwise those links report a false
# "down". Leave empty to use Docker's default resolution.
DASHBOARD_DNS=

# ─── Router ───

# Base URL of the OpenWrt router. The backend reverse-proxies /router/*
# here so LuCI is reachable from the dashboard origin.
ROUTER_URL=http://192.168.1.1

# Password for the ubus (OpenWrt) metrics collector. Kept out of
# config.yaml deliberately: config.yaml is editable from the browser.
OPENWRT_PASSWORD=

# ─── SSH metrics ───

# Private key mounted into the container for the ssh collector. It needs
# login access to every host with `ssh: true` in config.yaml. Prefer a
# dedicated key over reusing a personal one — see README.
SSH_KEY_FILE=~/.ssh/id_ed25519

# ─── netmap sidecar ───

# Image tag. Build and ship it with `make netmap-image` — it is NOT built
# by docker compose, because a Rust release build on an ARM SBC is slow.
NETMAP_IMAGE=netmap:latest

# Network to scan, and how often (seconds). An nmap sweep is noisy, so the
# default is hourly; use the dashboard's "Escanear ahora" button on demand.
NETMAP_TARGET=192.168.1.0/24
NETMAP_INTERVAL=3600

# Extra flags passed through to `netmap scan`. Empty means a full sweep,
# which is what you usually want: "--skip nmap" is much faster but falls
# back to ARP only, which misses the scanning host itself (a machine does
# not appear in its own ARP table) and yields no ports, hostnames or roles.
# "--ports 1-1024" goes deeper.
NETMAP_ARGS=
